# =====================================================================
# CloudGuard AI Platform — Environment Configuration Template
# All secrets MUST be provided via environment variables or secret store.
# Never commit actual secret values to version control.
# =====================================================================

# --- Core Application ---
PROJECT_NAME="CloudGuard AI Enterprise Platform"
ENVIRONMENT="development"
DEPLOYMENT_MODE="DEMO"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# --- Database ---
# Development: sqlite:///./cloudguard.db
# Docker Compose: postgresql://cloudguard:CloudGuard2026Secure!@db:5432/cloudguard_db
# Production (Supabase): postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite:///./cloudguard.db"

# --- Authentication & JWT ---
# Generate high-entropy 32-byte hex keys: `openssl rand -hex 32`
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret-in-production"
JWT_REFRESH_SECRET="replace-with-a-secure-random-32-byte-hex-refresh-secret-in-production"
JWT_SECRET_KEY="replace-with-a-secure-random-32-byte-hex-secret-in-production"
JWT_REFRESH_SECRET_KEY="replace-with-a-secure-random-32-byte-hex-refresh-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AES-256-GCM Master Key ---
# Must be exactly 64 hex characters (32 raw bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- CORS Security ---
# Comma-separated list of allowed origins (e.g. Vercel frontend URL). Never use "*" in production.
CORS_ORIGIN="https://cloudguard-ai.vercel.app,http://localhost:5173"

# --- Frontend API Endpoint (Vercel Build Environment) ---
VITE_API_URL="https://cloudguard-backend.onrender.com"

# --- Google Gemini GenAI ---
# Optional: If not provided or network offline, the platform operates in
# deterministic rule/ML mode with clear UI transparency.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=15

# --- Optional Cloud Provider Connectors ---
# Leave empty if provider is unconfigured. The platform marks unconfigured
# providers as "NOT CONFIGURED" and will never fabricate fake resources.

# AWS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
AWS_ROLE_ARN=""

# Azure
AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Google Cloud Platform
GCP_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Email Delivery (SMTP / Resend) ---
# Used for real OTP password resets. If unconfigured, the platform operates in
# Development Fallback mode and securely logs OTP delivery attempts without leaking credentials.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@cloudguard.ai"
SMTP_TLS=true
RESEND_API_KEY=""